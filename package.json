{
  "name": "ielts-reading-platform",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e:web": "pnpm --dir apps/web test:e2e",
    "dev:api": "uvicorn app.main:app --reload --app-dir services/api --port 8010",
    "test:api": "pytest services/api/tests -q"
  }
}
